# The rules of the repository this package used to live in stop at its edge:
# a parent's .gitignore does not reach inside a submodule. Everything the
# framework's own work leaves behind is therefore listed here, or it would be
# published along with the package.

# Byte code and interpreter caches
__pycache__/
*.py[cod]
*.so

# What `python -m build` leaves next to pyproject.toml
build/
dist/
*.egg-info/

# Test runs
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# The minified copy of the panel shell, built by the application's
# minify_frontend.sh and never committed.
static.min/

# Local environments and editors
.venv/
venv/
.idea/
.vscode/
.DS_Store

# The keepup region of the build tracker: the framework's own tasks, releases
# and their acceptance. Kept next to the framework so the tasks travel with it,
# and deliberately not tracked -- the tracker is data of the build, and the
# repository carries the code, the tests and the OpenSpec change.
ci/keepup/

# What the framework writes at run time when it is started from the repository
# itself: the application log, and the SQLite file of a local database.
logs/
data/

# The initializr and the keepup site: projects of the repository kept on disk
# while they are not tracked. The work continues outside git for now, and the
# suite's walks step over them (tests/repository.NOT_THE_PACKAGE).
/initializr/
/keepupproject.ru/
/keepup_site.example.zip
/tests/initializr_tests.py
/tests/initializr_service_tests.py
/openspec/changes/the-initializr/
/openspec/changes/the-initializr-service/
/openspec/changes/capability-tickboxes/
/openspec/changes/keepup-site/
